# Server
PORT=3002
PUBLIC_BASE_URL=https://your-domain.example
SQLITE_PATH=/opt/money-scissors/data/users.db

# Auth
# 0=鉴权开启（正式环境必须 0）。只有本地开发想免登录才设 1，且严禁带上正式站。
AUTH_DISABLED=0

# Required when AUTH_DISABLED=0 (即正式环境必填)
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_EXPIRE_HOURS=168
ADMIN_PHONES=13800138000

# DashScope transcription
DASHSCOPE_API_KEY=replace-with-dashscope-key

# DeepSeek analysis
DEEPSEEK_KEY=replace-with-deepseek-key

# SMS verification. Required only if AUTH_DISABLED=0
ALIYUN_ACCESS_KEY_ID=replace-with-aliyun-ak-id
ALIYUN_ACCESS_KEY_SECRET=replace-with-aliyun-ak-secret
ALIYUN_SMS_SIGN=replace-with-sms-sign
ALIYUN_SMS_TEMPLATE=replace-with-sms-template-code

# Optional limits
MAX_JSON_BYTES=2097152
MAX_DAILY_SMS_PER_PHONE=5
MAX_SMS_SENDS_PER_IP_WINDOW=20
SMS_IP_WINDOW_MINUTES=10
MAX_VERIFY_ATTEMPTS=5
VERIFY_CODE_TTL_MINUTES=5
VERIFY_LOCK_MINUTES=30
# 导出/精修并发闸门：正式站建议显式配置，避免依赖代码默认值。
# 粗剪全站默认 2、单用户 1、队列 20；机器吃紧时可把 CUT_MAX_ACTIVE_JOBS 改 1。
CUT_MAX_ACTIVE_JOBS=2
CUT_MAX_ACTIVE_JOBS_PER_USER=1
CUT_MAX_QUEUED_JOBS=20
REFINE_MAX_ACTIVE_JOBS=1
REFINE_MAX_ACTIVE_JOBS_PER_USER=1
CUT_PROGRESS_SAVE_MS=5000
CUT_PENDING_TTL=21600000
CUT_RUNNING_STALE_MS=5400000

# Development only. Do not enable on production.
ALLOW_DEV_SEND_CODE_FALLBACK=0

# 原音频/产物存储后端：local=ECS 本地盘（默认）；oss=阿里云 OSS。
# 出问题把 oss 改回 local 即可秒回退，无需回滚代码。
STORAGE_BACKEND=local
# 仅 STORAGE_BACKEND=oss 时生效：
# 前缀隔离——测试站必须 test、正式站必须 prod，缺失会拒绝启动。
OSS_PREFIX=test
OSS_REGION=cn-hangzhou
OSS_BUCKET=money-scissors-audio-prod
OSS_ACCESS_KEY_ID=replace-with-oss-ak-id
OSS_ACCESS_KEY_SECRET=replace-with-oss-ak-secret
# ECS 读写走内网 endpoint（同地域免流量费、快）。本地开发不在阿里云内网时设 0 改走公网。
OSS_INTERNAL=1
# 公网签名链接有效期（秒），DashScope 长音频转写留足，默认 7200=2h
OSS_SIGN_TTL=7200
